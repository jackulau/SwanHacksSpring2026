# Copy to backend/.env (gitignored) and fill in. dev.sh sources this file
# before launching pocketbase, so values land in the JS hook runtime via
# $os.getenv(...).

# Gemini API key — powers BOTH the ASL Vision recognizer AND the LLM
# features (Knowledge Ask, Inline AI, Generate flows, weekly digest, concept
# extraction, sandbox, AI brief). One key covers everything.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional vision model override (used by ASL). Defaults to gemini-2.0-flash.
# GEMINI_MODEL=gemini-2.0-flash

# Optional LLM model override (used by /api/llm/google). Defaults to
# gemini-2.0-flash. Try gemini-2.5-flash for higher quality.
# GEMINI_LLM_MODEL=gemini-2.0-flash
