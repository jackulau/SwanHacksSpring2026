# Copy to backend/.env (gitignored) and fill in. dev.sh sources this file
# before launching pocketbase, so values land in the JS hook runtime via
# $os.getenv(...).

# Gemini API key for the ASL Vision recognizer.
# Create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional model override. Defaults to gemini-2.0-flash. Try gemini-2.5-flash
# (when available on your key) for higher accuracy at slightly higher cost.
# GEMINI_MODEL=gemini-2.0-flash
